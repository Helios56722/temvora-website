---
import Icon from './Icon.astro';
import { services } from '../data/services';
const { kind='project' }=Astro.props;
const project=kind==='project', ticket=kind==='support', consultation=kind==='consultation';
---
<div class="form-panel"><p class="form-intro">{project?'Tell me what you need. Prepare a brief, then copy it or open Gmail in your browser.':ticket?'Describe what needs attention. Prepare your request, then copy it or open Gmail in your browser.':'Choose a preferred time to talk, then copy your request or open Gmail in your browser.'}</p>
<form class="smart-form" data-kind={kind}>
<div class="field-row"><label>Your name <input name="name" autocomplete="name" required maxlength="100"/></label><label>Email address <input name="email" type="email" autocomplete="email" required maxlength="254"/></label></div>
{project && <><label>Business or project name (optional) <input name="business" autocomplete="organization" maxlength="160"/></label><fieldset><legend>What can I help with?</legend><div class="choices">{services.map(({name:s})=><label><input name="service" type="checkbox" value={s}/><span>{s}</span></label>)}</div></fieldset><div class="field-row"><label>Budget range<select name="budget"><option>Let’s discuss</option><option>Under $1,000</option><option>$1,000–$2,500</option><option>$2,500–$5,000</option><option>$5,000+</option></select></label><label>Ideal timing<select name="timing"><option>Still exploring</option><option>Within a month</option><option>1–3 months</option><option>Flexible</option></select></label></div><label>What do you have in mind?<textarea name="details" rows="5" required maxlength="3000" placeholder="What would you like to create or fix? Include the details, goals, and timing that would help me understand your request."></textarea></label></>}
{ticket && <><div class="field-row"><label>What needs attention?<select name="category" required><option value="">Choose a category</option><option>Website update</option><option>Website not working</option><option>Domain, email, or hosting</option><option>IT troubleshooting</option><option>Project or billing question</option></select></label><label>How is it affecting you?<select name="impact" required><option>General question</option><option>Part of my work is affected</option><option>I can’t continue working</option></select></label></div><label>Website or service involved<input name="service" maxlength="200" placeholder="For example, your website address or email provider"/></label><label>Describe the issue<textarea name="details" required rows="5" maxlength="3000" placeholder="What happened, what did you expect, and when did it start? Include any steps that bring up the problem."></textarea></label></>}
{consultation && <><div class="field-row"><label>Preferred date<input name="date" type="date" required/></label><label>Preferred time<select name="time" required><option value="">Choose a time window</option><option>Morning (9am–12pm)</option><option>Afternoon (12pm–5pm)</option><option>Evening (5pm–8pm)</option><option>Flexible</option></select></label></div><label>Your time zone<input name="timezone" required maxlength="80" value="America/Chicago"/></label><label>What would you like to discuss?<textarea name="details" rows="4" required maxlength="2000"></textarea></label><p class="field-hint">This is a preferred time, not a confirmed booking. We’ll agree on availability by email.</p></>}
<p class="field-hint">Leave out passwords, payment details, and confidential files. Your request stays in this page until you copy, email, or download it.</p>
<label class="consent-line"><input type="checkbox" name="acknowledge" required/><span>I understand this prepares my request on this page and does not send it automatically. <a href="/legal/privacy/">Privacy information</a></span></label>
<noscript><p class="notice">JavaScript is needed to prepare a draft. You can <a href="mailto:tkjet718@gmail.com">email me directly</a>.</p></noscript><button class="button" type="submit" disabled>{project?'Prepare my project brief':ticket?'Prepare support request':'Prepare consultation request'} <Icon name="arrow" size={20}/></button>
<div class="form-result" hidden role="status" tabindex="-1"><h3>Your request is ready.</h3><p>Review it below, then choose the option that works best for you. Nothing has been sent yet.</p><pre class="draft-preview"></pre><div class="result-actions"><button type="button" class="button copy-draft">Copy request</button><a class="button button-outline gmail-draft" href="https://mail.google.com/" target="_blank" rel="noopener">Open Gmail <Icon name="mail" size={19}/></a></div><p class="copy-status" aria-live="polite"></p><div class="result-secondary"><a class="plain-link email-draft" href="mailto:tkjet718@gmail.com">Use my device’s email app</a><button type="button" class="plain-link download-draft">Download .txt <Icon name="download" size={18}/></button></div><p class="field-hint">Your device decides which program opens email-app links. On Windows, that may be Outlook.</p><p class="field-hint mail-length-note" hidden>Your request is long. Download it and attach it if an email service cuts it short.</p></div>
</form></div>
