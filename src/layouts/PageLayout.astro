---
import Wordmark from '../components/Wordmark.astro';
import Icon from '../components/Icon.astro';
const { title, description = 'Websites and advertising, document creation, and IT support for businesses and homes.', home = false } = Astro.props;
const nav = [['Home','/'],['Services','/services/'],['Portfolio','/portfolio/'],['Lab','/lab/'],['About','/about/'],['Support','/support/'],['Contact','/contact/']];
const current = Astro.url.pathname;
---
<!doctype html>
<html lang="en">
<head><meta charset="utf-8"/><meta name="viewport" content="width=device-width,initial-scale=1"/><meta name="theme-color" content="#05012D"/><meta name="robots" content="noindex,nofollow"/><title>{home ? 'TemVora — Websites, documents & IT support.' : title + ' — TemVora'}</title><meta name="description" content={description}/><meta property="og:title" content={title ? title + ' — TemVora' : 'TemVora'}/><meta property="og:description" content={description}/><meta property="og:type" content="website"/><link rel="icon" type="image/svg+xml" href="/brand/favicon.svg"/><link rel="preload" href="/brand/eb-garamond.woff2" as="font" type="font/woff2" crossorigin/><link rel="stylesheet" href="/styles.css"/><link rel="stylesheet" href="/brand/wordmark.css"/><script is:inline src="/script.js" defer></script><script is:inline src="/liquid-background.js" defer></script></head>
<body class:list={{'home-page':home}}>
<a class="skip-link" href="#main">Skip to content</a>
<div class="atmosphere" aria-hidden="true"><div class="liquid-static"></div><canvas id="liquid-background"></canvas><canvas id="starfield"></canvas></div>
<header class="site-header"><div class="header-inner"><a class="brand-link" href="/" aria-label="TemVora home"><Wordmark/></a><button class="menu-toggle" type="button" aria-expanded="false" aria-controls="main-nav"><Icon name="menu"/><span>Menu</span></button><nav id="main-nav" class="main-nav" aria-label="Main navigation">{nav.map(([label,href]) => <a href={href} aria-current={current===href ? 'page' : undefined}>{label}</a>)}<a href="/request/" class="nav-cta">Get started <Icon name="diagonal" size={16}/></a></nav></div></header>
<slot/>
<footer class="site-footer shell"><div class="footer-main"><div><a class="brand-link" href="/" aria-label="TemVora home"><Wordmark/></a><p>Websites. Documents. IT support.<br/>Help with what you need.</p></div><nav aria-label="Explore"><span class="micro">EXPLORE</span><a href="/services/">Services</a><a href="/portfolio/">Portfolio / samples</a><a href="/lab/">Product lab</a><a href="/pricing/">Packages</a><a href="/about/">About <Wordmark inline/></a></nav><nav aria-label="Get in touch"><span class="micro">LET’S TALK</span><a href="/request/">Start a project</a><a href="/consultation/">Plan a consultation</a><a href="/support/">Support desk</a><a href="/portal/">Client portal</a></nav><nav aria-label="Learn"><span class="micro">GOOD TO KNOW</span><a href="/faq/">Frequently asked questions</a><a href="/resources/">Journal / resources</a><a href="/contact/">Contact</a><a href="https://github.com/Helios56722" target="_blank" rel="noopener">GitHub ↗</a><button class="motion-toggle" type="button" aria-pressed="false"><Icon name="sound" size={16}/><span>Pause ambience</span></button></nav></div><div class="footer-bottom"><span>© {new Date().getFullYear()} <Wordmark inline/></span><nav aria-label="Policies"><a href="/legal/privacy/">Privacy</a><a href="/legal/terms/">Terms</a><a href="/legal/accessibility/">Accessibility</a><a href="/legal/refunds/">Refunds & cancellations</a></nav><span class="micro">DESIGN PREVIEW</span></div></footer>
</body></html>
