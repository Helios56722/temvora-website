---
import PageLayout from '../layouts/PageLayout.astro';import Intro from '../components/Intro.astro';import Icon from '../components/Icon.astro';
---
<PageLayout title="Client portal"><main id="main"><Intro label="Client portal" title="Your project, in one place." copy="A dedicated space for project updates and support is planned."/><div class="shell"><section class="status-panel"><Icon name="lock" size={36}/><p class="eyebrow">PORTAL CONNECTION PENDING</p><h2>Client sign-in is not available yet.</h2><p>For now, contact me for a project update or prepare a support email. No accounts, passwords, documents, or payments are collected on this page.</p><div class="inline-actions"><a class="button" href="/support/">Visit support <Icon name="arrow" size={18}/></a><a class="text-link" href="/contact/">Contact me <Icon name="diagonal" size={18}/></a></div></section></div></main></PageLayout>