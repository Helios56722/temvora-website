---
import PageLayout from '../layouts/PageLayout.astro';
import Intro from '../components/Intro.astro';
import Icon from '../components/Icon.astro';
import { services } from '../data/services';
---
<PageLayout title="Services & packages">
<main id="main">
<Intro label="Packages" title="What do you need help with?" copy="Three service areas, with a quote based on the work you need. You can combine services in one project."/>
<section class="shell page-content">
<div class="package-table">{services.map(p=><article class="package-row"><div><span class="micro">{p.number} / SERVICE</span><h2>{p.name}</h2><p>{p.description}</p></div><ul>{p.items.map(item=><li>{item}</li>)}</ul><div><span class="quote-label">QUOTED FOR YOUR PROJECT</span><a href={'/request/?package='+encodeURIComponent(p.name)} class="button button-outline">Request a quote <Icon name="diagonal" size={18}/></a></div></article>)}</div>
<p class="notice">I’ll confirm the scope, price, timing, and any ongoing costs before work begins. Contract and agreement services cover document preparation and formatting; legal advice and review of enforceability belong with your attorney.</p>
<a href="/faq/" class="text-link">Questions before you start? <Icon name="arrow" size={18}/></a>
</section></main></PageLayout>
