---
import Wordmark from '../components/Wordmark.astro';
import PageLayout from '../layouts/PageLayout.astro';import Intro from '../components/Intro.astro';import InquiryForm from '../components/InquiryForm.astro';
---
<PageLayout title="Support desk"><main id="main"><Intro label="Support desk" title="Let’s get things working." copy="A website update, a technical problem, or a question about your project. Put the details in one place."/><section class="shell page-content ticket-layout"><aside class="technical-panel"><div class="technical-bar"><span><Wordmark inline/> / SUPPORT DESK</span><span>01 — INTAKE</span></div><div class="tech-diagram" aria-hidden="true"><svg viewBox="0 0 400 230" fill="none" stroke="currentColor" stroke-width="1"><path d="M20 40H90L140 90M0 160H85L140 135M255 85H290L325 35H400M255 145H305L335 185H400M177 0V55M219 0V55M177 175V230M219 175V230"/><g class="tech-pulse" stroke="#d94ddb" stroke-width="2"><path d="M20 40H90L140 90M0 160H85L140 135M255 85H290L325 35H400M255 145H305L335 185H400"/></g><rect x="140" y="55" width="115" height="120"/><rect x="150" y="65" width="95" height="100"/><rect x="165" y="82" width="65" height="57"/><path d="M185 140v12M207 140v12M175 152h42M177 100l-6 9 6 9M219 100l6 9-6 9M202 98l-10 22"/><circle cx="20" cy="40" r="4"/><circle cx="335" cy="185" r="4"/></svg></div><div class="technical-readout"><span class="vertical-label">REQUEST / DIAGNOSTICS</span><dl><div><dt>CHANNEL</dt><dd>Email request</dd></div><div><dt>START WITH</dt><dd>What changed?</dd></div><div><dt>INCLUDE</dt><dd>Steps to reproduce</dd></div><div><dt>PRIVATE FILES</dt><dd>Arrange secure transfer</dd></div><div><dt>TICKET HISTORY</dt><dd>Not connected yet</dd></div></dl></div><p>This desk prepares a support email. A tracked ticket service and client history are not connected in this preview.</p></aside><InquiryForm kind="support"/></section></main></PageLayout>